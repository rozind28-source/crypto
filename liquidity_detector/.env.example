# =============================================================================
# LIQUIDITY DETECTOR CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Bybit WebSocket v5 Settings
# -----------------------------------------------------------------------------
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
SYMBOL=BTCUSDT
CATEGORY=linear
DEPTH_LEVEL=50

# -----------------------------------------------------------------------------
# Detector Settings - Volume Delta Divergence
# -----------------------------------------------------------------------------
# Time window in seconds for calculating volume delta
DELTA_WINDOW_SEC=60

# Minimum delta in USDT to trigger divergence alert
DELTA_THRESHOLD_USDT=50000

# Maximum price change percentage to consider for divergence
# (if price moves more than this, it's not a divergence)
PRICE_CHANGE_THRESHOLD_PCT=0.5

# -----------------------------------------------------------------------------
# Detector Settings - Spoofing/Layering Detection
# -----------------------------------------------------------------------------
# Minimum order size in USDT to monitor for spoofing
SPOOF_SIZE_THRESHOLD_USDT=100000

# Maximum lifetime in seconds for an order to be considered a spoof
SPOOF_LIFETIME_SEC=0.5

# -----------------------------------------------------------------------------
# Web Server Settings
# -----------------------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8000

# -----------------------------------------------------------------------------
# Telegram Notification Settings (NOT USED - kept for compatibility)
# -----------------------------------------------------------------------------
# The web interface version does not use Telegram alerts.
# All alerts are displayed in the web UI at http://localhost:8000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
