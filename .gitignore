```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled files
*.o
*.obj
*.so
*.a
*.dll
*.exe
*.out
*.class

# Dependencies
.venv/
venv/
.env
.env.local
.env.*

# Build artifacts
dist/
build/
target/

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo

# Editors
.vscode/
.idea/

# System files
.DS_Store
Thumbs.db

# Coverage
.coverage
coverage/
htmlcov/

# Testing
.mypy_cache/
.pytest_cache/
```